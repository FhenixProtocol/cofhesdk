{
  "name": "@cofhe/contract-check",
  "version": "0.0.0",
  "type": "module",
  "description": "Static checks for CoFHE encrypted-type boundary rules, run against compiler build-info",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "bin": {
    "contract-check": "./dist/cli.js"
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json"
  },
  "devDependencies": {
    "@cofhe/tsconfig": "workspace:*",
    "typescript": "^5.5.4",
    "vitest": "^2.0.5"
  }
}
