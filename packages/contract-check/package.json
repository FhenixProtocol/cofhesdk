{
  "name": "@cofhe/contract-check",
  "version": "0.0.0",
  "type": "module",
  "description": "Static checks for CoFHE encrypted-type boundary rules, run against compiler build-info",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "bin": {
    "contract-check": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check:types": "tsc --noEmit",
    "lint": "eslint \"**/*.ts\"",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@cofhe/eslint-config": "workspace:*",
    "@cofhe/tsconfig": "workspace:*",
    "typescript": "5.5.4",
    "vitest": "3.2.4"
  }
}
